# ── Runtime ──────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
PUBLIC_BASE_URL=

# ── Database ─────────────────────────────────────────────────────────────────
# Local dev uses the PostgreSQL 18 already installed on this machine.
# Percent-encode any @ : / ? # in the password.
DATABASE_URL=postgresql+asyncpg://krova:CHANGEME@localhost:5432/krova

# ── Auth (we issue our own tokens - no external identity provider) ───────────
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ── Meta ─────────────────────────────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_API_VERSION=v25.0
# Facebook Login for Business -> Configurations
META_CONFIG_ID=
WHATSAPP_DATA_LOCALIZATION_REGION=IN

# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Email channels (added when Gmail/Outlook are wired) ──────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ── Voice (added when the voice service ships) ───────────────────────────────
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
SARVAM_API_KEY=
